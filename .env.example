# 🔧 Variáveis de Ambiente
# Copie este arquivo para .env e configure conforme necessário.
#
# ⚠️ Nada carrega o .env automaticamente hoje (ver docs/MELHORIAS.md).
# Use `node --env-file-if-exists=.env server.js` ou exporte as variáveis.

# Ambiente (development, production)
NODE_ENV=development

# Porta do servidor
PORT=3000

# URL do MongoDB
# Local:  mongodb://localhost:27017/jogo-da-velha
# Docker: mongodb://mongo:27017/jogo-da-velha
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/jogo-da-velha
MONGODB_URI=mongodb://localhost:27017/jogo-da-velha

# ---------------------------------------------------------------------------
# Sessão / autenticação
# ---------------------------------------------------------------------------

# Assina o cookie de sessão. OBRIGATÓRIO em produção — sem ele o servidor se
# recusa a subir, porque um segredo novo a cada boot derrubaria todos os logins.
# Em desenvolvimento, um segredo temporário é gerado com aviso no console.
# Gere o seu com: openssl rand -hex 32
# SESSION_SECRET=

# Marca o cookie de sessão como Secure. Deixe desligado para jogar em rede local
# sobre HTTP puro — ligue ao servir por HTTPS.
COOKIE_SECURE=false

# Ligue se o app estiver atrás de proxy reverso (nginx, Traefik, Cloudflare),
# para que o rate limit por IP enxergue o IP real do cliente.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Ainda não implementadas (ver docs/MELHORIAS.md)
# ---------------------------------------------------------------------------

# CHAT_RATE_LIMIT=10
# GAME_RATE_LIMIT=10
# LOG_LEVEL=info
